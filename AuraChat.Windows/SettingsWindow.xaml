<Window x:Class="AuraChat.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Height="660" Width="940" MinHeight="540" MinWidth="800"
        Icon="app.ico" Background="{DynamicResource Bg}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="196"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid x:Name="BackdropLayer" Grid.ColumnSpan="2" Visibility="Collapsed" IsHitTestVisible="False">
            <Image x:Name="BackdropImage" Stretch="UniformToFill" />
            <Border x:Name="BackdropTint" Background="{DynamicResource GlassOverlay}" />
        </Grid>

        <Border x:Name="Sidebar" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
            <DockPanel Margin="8">
                <TextBlock DockPanel.Dock="Top" Text="设置" FontSize="16" FontWeight="SemiBold" Margin="10,10,10,14"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="NavPanel"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid x:Name="ContentRoot" Grid.Column="1">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="20,12">
                    <DockPanel>
                        <StackPanel x:Name="HeadRight" DockPanel.Dock="Right" Orientation="Horizontal"
                                    VerticalAlignment="Center" />
                        <TextBlock x:Name="HeadText" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
                <Border DockPanel.Dock="Bottom" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="20,8">
                    <TextBlock x:Name="StatusText" FontSize="12" Foreground="{DynamicResource Dim}" TextWrapping="Wrap"/>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,16">
                    <StackPanel x:Name="Body" MaxWidth="720" HorizontalAlignment="Left"/>
                </ScrollViewer>
            </DockPanel>

            <Border x:Name="ToastBox" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,56" Background="{DynamicResource Accent}" CornerRadius="7" Padding="14,7"
                    IsHitTestVisible="False">
                <TextBlock x:Name="ToastText" Foreground="White" FontSize="12"/>
            </Border>
        </Grid>
    </Grid>
</Window>
